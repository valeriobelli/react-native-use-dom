{
	"$schema": "node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"ignorePatterns": [
		"**/dist/**",
		"**/lib/**",
		"**/Pods/**",
		"pnpm-lock.yaml",
		"**/build/**",
		"**/nitrogen/generated/**"
	],
	"printWidth": 120,
	"semi": false,
	"singleQuote": true,
	"sortImports": true,
	"trailingComma": "all",
	"useTabs": true
}
