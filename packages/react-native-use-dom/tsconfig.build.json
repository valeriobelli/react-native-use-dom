{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"tsBuildInfoFile": "dist/.tsbuildinfo"
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**", "src/**/__fixtures__/**", "src/docs/**"]
}
