{
	"name": "react-native-use-dom",
	"version": "0.0.1",
	"description": "Render real React DOM components inside React Native with the 'use dom' directive. No Expo required.",
	"keywords": [
		"dom",
		"metro",
		"nitro",
		"react-native",
		"use dom",
		"webview"
	],
	"homepage": "https://github.com/valeriobelli/react-native-use-dom#readme",
	"license": "MIT",
	"author": "Valerio Belli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/valeriobelli/react-native-use-dom.git",
		"directory": "packages/react-native-use-dom"
	},
	"files": [
		"lib",
		"src",
		"nitrogen",
		"nitro.json",
		"react-native.config.js",
		"*.podspec",
		"ios/**/*.swift",
		"android/build.gradle",
		"android/gradle.properties",
		"android/fix-prefab.gradle",
		"android/CMakeLists.txt",
		"android/src",
		"css.d.ts",
		"README.md",
		"AGENTS.md",
		"!lib/**/*.test.*",
		"!lib/docs",
		"!src/**/__tests__",
		"!src/**/__fixtures__",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/docs"
	],
	"type": "commonjs",
	"main": "./lib/commonjs/native/index.js",
	"module": "./lib/module/native/index.js",
	"types": "./lib/typescript/commonjs/native/index.d.ts",
	"exports": {
		".": {
			"react-native": {
				"types": "./lib/typescript/module/native/index.d.ts",
				"default": "./lib/module/native/index.js"
			},
			"module": {
				"types": "./lib/typescript/module/native/index.d.ts",
				"default": "./lib/module/native/index.js"
			},
			"default": {
				"types": "./lib/typescript/commonjs/native/index.d.ts",
				"default": "./lib/commonjs/native/index.js"
			}
		},
		"./dom": {
			"types": "./lib/typescript/commonjs/web/index.d.ts",
			"default": "./lib/commonjs/web/index.js"
		},
		"./babel": {
			"types": "./lib/typescript/commonjs/babel/index.d.ts",
			"default": "./lib/commonjs/babel/index.js"
		},
		"./metro": {
			"types": "./lib/typescript/commonjs/metro/index.d.ts",
			"default": "./lib/commonjs/metro/index.js"
		},
		"./internal": {
			"types": "./lib/typescript/commonjs/runtime/index.d.ts",
			"default": "./lib/commonjs/runtime/index.js"
		},
		"./css": {
			"types": "./css.d.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "bob build && node ./scripts/copy-view-config.mjs",
		"prepack": "pnpm build",
		"clean": "rm -rf lib dist *.tsbuildinfo",
		"codegen": "nitrogen"
	},
	"dependencies": {
		"@babel/runtime": "^7.29.7",
		"react-refresh": "0.14.2"
	},
	"devDependencies": {
		"@react-native/metro-config": "0.87.1",
		"@types/jsdom": "21.1.7",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.5.10",
		"jsdom": "26.1.0",
		"metro": "0.87.1",
		"metro-babel-transformer": "0.87.1",
		"metro-config": "0.87.1",
		"metro-resolver": "0.87.1",
		"metro-runtime": "0.87.1",
		"nitrogen": "^0.37.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.87.1",
		"react-native-builder-bob": "0.43.1",
		"react-native-nitro-modules": "0.37.1",
		"ws": "8.22.0"
	},
	"peerDependencies": {
		"metro": ">=0.83.1",
		"metro-config": ">=0.83.1",
		"metro-runtime": ">=0.83.1",
		"react": ">=19.1.0",
		"react-dom": ">=19.1.0",
		"react-native": ">=0.81.0",
		"react-native-nitro-modules": ">=0.29.0"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"exclude": "**/{__tests__,__fixtures__,__mocks__,docs}/**",
		"targets": [
			[
				"module",
				{
					"esm": true
				}
			],
			"commonjs",
			[
				"typescript",
				{
					"project": "tsconfig.build.json"
				}
			]
		]
	}
}
